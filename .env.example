# Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git - it contains sensitive information

# Mapbox API Token (client-side - must be prefixed with NEXT_PUBLIC_)
# Get your token at: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# OpenWeatherMap API Key (server-side only)
# Get a free API key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Formspree Endpoint (client-side - must be prefixed with NEXT_PUBLIC_)
# Create a form at: https://formspree.io/ and get your endpoint
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id_here
